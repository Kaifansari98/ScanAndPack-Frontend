{
  "expo": {
    "name": "Furnix",
    "slug": "furnix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/furnix.jpeg",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan QR codes.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.vloq.furnixcrm"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/furnix.jpeg",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": true,
      "package": "com.vloq.furnixcrm"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/furnix.jpeg"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to photos to attach defect images.",
          "cameraPermission": "Allow camera access to capture defect photos."
        }
      ],
      "expo-router",
      "expo-camera",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/furnix.jpeg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2ac0aa5a-52a6-4ba4-9ae7-e4a39d418d5e"
      }
    },
    "owner": "vloq"
  }
}
